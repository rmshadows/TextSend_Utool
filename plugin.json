{
  "version": "5.0.16",
  "pluginName": "Textsend-uTools",
  "description": "局域网文字与文件投送",
  "author": "Ryan Yim",
  "homepage": "https://github.com/rmshadows/TextSend_Utool",
  "platform": ["win32", "linux"],
  "main": "ui/index.html",
  "preload": "tspreload.js" ,
  "development": {
    "preload": "tspreload.js"
  },
  "logo": "logo.png",
  "features": [
    {
      "code": "textsend",
      "explain": "局域网文字与文件投送",
      "cmds": [
        "Textsend",
        "TextSend",
        "Textsend-uTools",
        "文字传输",
        "ts",
        {
          "type": "regex",
          "label": "用 TextSend 连接",
          "match": "/(?:^|\\s)(?:ts:\\/\\/)?(?:\\[[^\\]]+\\]|[A-Za-z0-9._-]+)(?::\\d{1,5})?\\/k\\S+/i",
          "minLength": 10,
          "maxLength": 512
        }
      ],
      "icon": "logo.png"
    }
  ],
  "pluginSetting": {
    "single": false
  }
}
